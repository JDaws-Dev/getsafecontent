{
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "https://rightful-rabbit-333.convex.site/api/auth/:path*"
    },
    {
      "source": "/tube/api/auth/:path*",
      "destination": "https://rightful-rabbit-333.convex.site/api/auth/:path*"
    },
    {
      "source": "/tube/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/tube/:file(apple-touch-icon.svg|favicon.svg|icon-192.svg|icon-512.svg|manifest.json|og-image.png|og-image.svg|robots.txt)",
      "destination": "/:file"
    },
    {
      "source": "/tube/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
