{
  "rewrites": [
    {
      "source": "/study/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/study/:file(.*\\.(svg|png|json|txt|ico|webmanifest))",
      "destination": "/:file"
    },
    {
      "source": "/study/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
