{
  "rewrites": [
    {
      "source": "/study/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/study/:file(apple-touch-icon.png|favicon.svg|icon-192.png|icon-512.png|manifest.json|og-image.png|robots.txt|sitemap.xml)",
      "destination": "/:file"
    },
    {
      "source": "/study/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
